# CineForge — cấu hình AI (bước "Kịch bản")
#
# QUAN TRỌNG: các key dưới đây là secret phía SERVER — KHÔNG được thêm tiền tố
# VITE_ (nếu thêm, Vite sẽ nhúng thẳng key vào bundle JS gửi cho trình duyệt,
# ai mở DevTools cũng đọc được → bị lộ key). Code chỉ đọc các key này bằng
# `process.env` bên trong server function (src/lib/cine/ai.ts), không bao giờ
# gửi ra client.
#
# Chỉ cần điền MỘT trong các key dưới đây là app đã dùng được AI viết kịch
# bản — không cần điền hết. Thứ tự ưu tiên khi có nhiều key cùng lúc:
# OpenAI > Groq > DeepSeek > OpenRouter > Gemini > xAI (Grok).



# Sau khi sửa file .env, LUÔN khởi động lại server (npm run dev) —
# biến môi trường chỉ được đọc lúc server khởi động, sửa .env khi server đang
# chạy sẽ không có tác dụng cho tới lần chạy lại tiếp theo.

# --- Xuất video bằng FFmpeg trên máy chủ (không bắt buộc) ---
# RENDER_MAX_UPLOAD_MB=1024      # dung lượng video tải lên tối đa
# RENDER_MAX_CONCURRENT=1        # số video render cùng lúc
# FFMPEG_PATH=ffmpeg             # đường dẫn ffmpeg nếu không nằm trong PATH
# FFPROBE_PATH=ffprobe
# RENDER_FONT_FILE=              # font .ttf có dấu tiếng Việt (mặc định: server-assets/fonts/DejaVuSans-Bold.ttf)
# FFMPEG_VIDEO_CODEC=auto        # "auto" (tự nhận GPU NVIDIA h264_nvenc, nếu không có sẽ dùng CPU libx264) hoặc gán hẳn "h264_nvenc" / "libx264"
# FFMPEG_PRESET=veryfast         # Tốc độ mã hóa: libx264 ("ultrafast", "veryfast", "fast"). NVENC: "p1" đến "p7" (mặc định p4)
# FFMPEG_CRF=20                  # Mức chất lượng: CRF cho libx264 (mặc định 20), CQ cho NVENC (mặc định 22)

# --- Tải video từ link YouTube/TikTok (yt-dlp, không bắt buộc) ---
# YTDLP_PATH=yt-dlp
# DOWNLOAD_MAX_SIZE=1G
# DOWNLOAD_EXTRA_HOSTS=          # thêm host được phép, cách nhau bằng dấu phẩy
